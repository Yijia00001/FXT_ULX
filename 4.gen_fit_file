#!/bin/bash
## fit the spectra 

cat obsid_list.txt | while read line;
do
    cd data/$line
    pwd
    if [ ! -d "./fit_image" ]; then
        echo "fit_image doesn't exist, make it"
        mkdir fit_image
    fi
    source_num=`ls a/x*.reg | wc -l`
    source_index=1
    
    while [ $source_index -le ${source_num} ]
    do
        echo "
cd a/x${source_index}
data 1:1 x${source_index}_grp.pi
cd ../..
cd b/x${source_index}
data 2:2 x${source_index}_grp.pi
cd ../..

ignore 1:**-0.5 10.0-**
ignore 2:**-0.5 10.0-**
ignore bad

model tbabs*cflux*po
0.1
0.5
10
-12
2
1

#newpar 7 1.0

freeze 6
fit 1000

echo \"source,para,value,value_down,value_up\" > x${source_index}_fit_results.csv

error 1 4 5

tclout param 1
set x [string trim \$xspec_tclout]
set pos [string first { } \$x]
set cf [string range \$x 0 [expr \$pos]]

tclout error 1
set cfe [string trim \$xspec_tclout]
scan \$cfe \"%f %f\" e1 e2
echo 'x${source_index},NH,\$cf,\$e1,\$e2' >> x${source_index}_fit_results.csv

tclout param 4
set x [string trim \$xspec_tclout]
set pos [string first { } \$x]
set cf [string range \$x 0 [expr \$pos]]

tclout error 4
set cfe [string trim \$xspec_tclout]
scan \$cfe \"%f %f\" e1 e2
echo 'x${source_index},Flux,\$cf,\$e1,\$e2' >> x${source_index}_fit_results.csv

tclout param 5
set x [string trim \$xspec_tclout]
set pos [string first { } \$x]
set cf [string range \$x 0 [expr \$pos]]

tclout error 5
set cfe [string trim \$xspec_tclout]
scan \$cfe \"%f %f\" e1 e2
echo 'x${source_index},PhotonIndex,\$cf,\$e1,\$e2' >> x${source_index}_fit_results.csv

tclout stat
scan \$xspec_tclout \"%f\" chi2

tclout dof
set x [string trim \$xspec_tclout]
scan \$x \"%f %f\" dof1 dof2
echo 'x${source_index},dof,\$chi2,\$dof1,\$dof2' >> x${source_index}_fit_results.csv

setplot device /xs
setplot device x${source_index}.png/png
setp en
pl ld del

quit
y

exit
" > cal_flux_x${source_index}.xcm
#mv x${source_index}.ps fit_image
# setp en
# pl ld del
# hardcopy 
#cpd /xw
#fit_image/x${source_index}.ps/ps
#iplot ld del
#mv pgplot.ps fit_image/x${source_index}.ps
        #xspec - cal_flux_x${source_index}
        #cd ..
        let source_index++
    done
    #break 4
    cd ../..

done


