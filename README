## THE README IS FOR HOW TO RUN THE CODEs

## finish files in the file, utilized in 0., 1., generate_source_reg, 
## finish.txt

## unzip all of the zip data files from ~/downloads/ to the data folder
. unzip_mkdata_dir

## copy bkg reg to all of the obsid folders
python3 cp_bkg_files.py

## plug the obsid list to obsid_list.txt
ls data > obsid_list.txt

## RUN the wavedetect to detect sources, need CIAO environment
. 0.wavdetect_source 

## generate the exposure map, need fxtsoft environment
. 1.gen_expo_img

## generate source region file for each source
python3 generate_source_reg.py

## You need to generate th bkg.reg for each observation by hand
## generate .pi, .rmf, .arf files for each source it should be mentioned that 
## bkg.reg is need to be genereted by hands
. 2.spec

## generate grp file for spectra
python3 grpmin.py

## grppha spectra utilizing the grp files from grpmin.py
.  3.grp_spec

## fit the spectrum of sources in source_list.txt
python3 gen_fxt_spec_files.py
. run_fit_fxt_spec

## Here I would like to generate the spectrum for bkg sources
python3 gen_bkg_spec_files.py
. run_gen_bkg_rate_flux

## estimate count rate of each source using aprates, need CIAO environment
python3 gen_aprates_files.py
. run_aprates

## generate xspec files for each source
# python3 gen_fxt_spec_files.py
# . run_fit_fxt_spec
#. 4.gen_fit_file

## check ULX targets in Walton et al. 2018, If you trust the results from this
## selection, you can find the coordinates of targets in ULX_list.py and copy them 
## to the top of gen_source_list.py
python3 check_ULX_in_gal.py

## generate source list for given known sources
python3 gen_source_list.py


## plot the results of ULXs
python3 plot_ULX.py
## plot the results of selected sources
python3 plot_select_sources.py

## generate the ref sources from CSC and sxps
python3 gen_csc_list.py
python3 gen_sxps_list.py

## plot the whole images of each galaxy
python3 plot_gal_img.py

