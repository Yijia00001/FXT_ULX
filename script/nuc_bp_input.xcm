statistic cstat
data 1:1 bin_nuc.pi
# ignore **-0.3 10.-**
ignore bad

model  TBabs*TBabs*cflux*bknpower  
         0.0206     -0.001          0          0     100000      1e+06
       0.108576     -0.001          0          0     100000      1e+06
            0.3       -0.1          0          0      1e+06      1e+06
             10       -0.1          0          0      1e+06      1e+06
            -12       0.01       -100       -100        100        100       
        1.50464      -0.01         -3         -2          9         10
        3.46131      -0.01          0       0.01      1e+06      1e+06
        2.26675      -0.01         -3         -2          9         10
    0.000206713      -0.01          0          0      1e+20      1e+24

query yes
fit
err 1.0 5

tclout param 5
set x [string trim $xspec_tclout]
set pos [string first { } $x]
set cf [string range $x 0 [expr $pos]]
tclout error 5
set cfe [string trim $xspec_tclout]
scan $cfe "%f %f" e1 e2
echo '$cf $e1 $e2' >> flux.txt

save all nuc_bp
exit
