#!/bin/bash

obsids=`ls -d [0-9][0-9][0-9]* `

for obsid in ${obsids};
do
	echo Processing ObsID $obsid ...
	
	cd $obsid
	
	# determine which CCD images were created
	CCDs=`ls *band1_flux.img | cut -d _ -f1`
	
	for CCDID in $CCDs
	do
	
		if [ ! -e ${CCDID}.gti ]
		then
	
			punlearn dmextract
			dmextract infile="${CCDID}.evt[bin time=::200][exclude sky=region(wav_${CCDID}.reg)]" \
	   	outfile=${CCDID}_bkg.lc opt=ltc1 clobber=yes
	
	
			deflare ${CCDID}_bkg.lc outfile=${CCDID}.gti method=sigma save=${CCDID}_gti.ps
		
			dmcopy "${CCDID}.evt[@${CCDID}.gti]" ${CCDID}_gti.evt clobber=yes
		fi
		
		
	done

	
	
	# fplot bkg.lc time counts - /xs quit
	# read -n1 -r -p "Press space to continue..." key

	# return to the root directory
	cd ..
	
done


