
cd a/x5
data 1:1 x5_grp.pi
cd ../..
cd b/x5
data 2:2 x5_grp.pi
cd ../..

ignore 1:**-0.5 10.0-**
ignore 2:**-0.5 10.0-**
ignore bad

model tbabs*cflux*po
0.1
0.5
10
-12
2
1

#newpar 7 1.0

freeze 6
fit 1000

echo "source,para,value,value_down,value_up" > x5_fit_results.csv

error 1 4 5

tclout param 1
set x [string trim $xspec_tclout]
set pos [string first { } $x]
set cf [string range $x 0 [expr $pos]]

tclout error 1
set cfe [string trim $xspec_tclout]
scan $cfe "%f %f" e1 e2
echo 'x5,NH,$cf,$e1,$e2' >> x5_fit_results.csv

tclout param 4
set x [string trim $xspec_tclout]
set pos [string first { } $x]
set cf [string range $x 0 [expr $pos]]

tclout error 4
set cfe [string trim $xspec_tclout]
scan $cfe "%f %f" e1 e2
echo 'x5,Flux,$cf,$e1,$e2' >> x5_fit_results.csv

tclout param 5
set x [string trim $xspec_tclout]
set pos [string first { } $x]
set cf [string range $x 0 [expr $pos]]

tclout error 5
set cfe [string trim $xspec_tclout]
scan $cfe "%f %f" e1 e2
echo 'x5,PhotonIndex,$cf,$e1,$e2' >> x5_fit_results.csv

tclout stat
scan $xspec_tclout "%f" chi2

tclout dof
set x [string trim $xspec_tclout]
scan $x "%f %f" dof1 dof2
echo 'x5,dof,$chi2,$dof1,$dof2' >> x5_fit_results.csv

setplot device /xs
setplot device x5.png/png
setp en
pl ld del

quit
y

exit

