
cd a/x1
data 1:1 x1_grp.pi
cd ../..
cd b/x1
data 2:2 x1_grp.pi
cd ../..

ignore 1:**-0.5 10.0-**
ignore 2:**-0.5 10.0-**
ignore bad

model const*tbabs*cflux*po
1
0.1
0.5
10
-12
2
1

#newpar 7 1.0

freeze 7
freeze 1
newpar 8 1.0

fit 3000

echo "source,para,value,value_down,value_up" > x1_fit_results.csv

error 2 5 6

tclout param 2
set x [string trim $xspec_tclout]
set pos [string first { } $x]
set cf [string range $x 0 [expr $pos]]

tclout error 2
set cfe [string trim $xspec_tclout]
scan $cfe "%f %f" e1 e2
echo 'x1,NH,$cf,$e1,$e2' >> x1_fit_results.csv

tclout param 5
set x [string trim $xspec_tclout]
set pos [string first { } $x]
set cf [string range $x 0 [expr $pos]]

tclout error 5
set cfe [string trim $xspec_tclout]
scan $cfe "%f %f" e1 e2
echo 'x1,Flux,$cf,$e1,$e2' >> x1_fit_results.csv

tclout param 6
set x [string trim $xspec_tclout]
set pos [string first { } $x]
set cf [string range $x 0 [expr $pos]]

tclout error 6
set cfe [string trim $xspec_tclout]
scan $cfe "%f %f" e1 e2
echo 'x1,PhotonIndex,$cf,$e1,$e2' >> x1_fit_results.csv

tclout stat
scan $xspec_tclout "%f" chi2

tclout dof
set x [string trim $xspec_tclout]
scan $x "%f %f" dof1 dof2
echo 'x1,dof,$chi2,$dof1,$dof2' >> x1_fit_results.csv

setplot device /xs
setplot device x1.png/png
setp en
pl ld del

quit
y

exit

